{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "且记 Windows",
  "version": "0.1.0",
  "identifier": "com.luyaowo.qieji",
  "build": {
    "beforeDevCommand": "node Scripts/build-frontend.cjs",
    "beforeBuildCommand": "node Scripts/build-frontend.cjs",
    "frontendDist": "../Resources"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "且记",
        "width": 720,
        "height": 840,
        "minWidth": 500,
        "minHeight": 560,
        "visible": false,
        "resizable": true,
        "backgroundColor": "#f5f4ed",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
